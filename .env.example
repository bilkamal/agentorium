# ──────────────────────────────────────────────────────────────────────────
# Agent Office — server settings
#
# Agents (roles, providers, models, API keys) are edited in the web UI (⚙ Team
# settings) and stored in data/agents.json. The OFFICE_A/B/C_* values below only
# seed the first three agents when data/agents.json does not exist yet.
#
# PROVIDER options:
#   anthropic  -> Claude via the official Anthropic SDK (needs API key)
#   openai     -> any OpenAI-compatible /chat/completions endpoint
#                 (OpenAI, OpenRouter, Nous Portal, Groq, Ollama, LM Studio, vLLM ...)
#   mock       -> no network; canned replies for trying the UI / workflow
# ──────────────────────────────────────────────────────────────────────────

OFFICE_HOST=127.0.0.1          # 0.0.0.0 to reach it from other devices (no auth! see README)
OFFICE_PORT=8000
OFFICE_LANG=id                 # id | en — UI default, mock replies, system notes
OFFICE_MAX_REVISIONS=2         # how many times the supervisor may send a step back
OFFICE_DOC_MAX_CHARS=60000     # per-document text limit injected into prompts
OFFICE_ANTHROPIC_FALLBACKS=1   # server-side refusal fallbacks on supported Claude models
OFFICE_API_TOKEN=              # optional shared secret for the external events API (sdk/)

# Defaults used by any seeded agent without its own setting
OFFICE_DEFAULT_PROVIDER=mock
OFFICE_DEFAULT_MODEL=claude-opus-5-5
OFFICE_DEFAULT_API_KEY=
OFFICE_DEFAULT_BASE_URL=
OFFICE_DEFAULT_MAX_TOKENS=16000

# Seed: A = worker, B = supervisor, C = client (only used on first start)
#OFFICE_A_PROVIDER=anthropic
#OFFICE_A_MODEL=claude-opus-5-5
#OFFICE_A_API_KEY=sk-ant-...
#OFFICE_A_EFFORT=high          # anthropic only: low | medium | high | xhigh | max
#OFFICE_B_PROVIDER=anthropic
#OFFICE_B_MODEL=claude-opus-5-5
#OFFICE_B_API_KEY=sk-ant-...
#OFFICE_C_PROVIDER=openai
#OFFICE_C_MODEL=nousresearch/hermes-4-405b
#OFFICE_C_API_KEY=sk-or-...
#OFFICE_C_BASE_URL=https://openrouter.ai/api/v1
#OFFICE_C_TEMPERATURE=0.7      # openai-compatible only

# Example: local Ollama
#OFFICE_A_PROVIDER=openai
#OFFICE_A_MODEL=hermes3
#OFFICE_A_BASE_URL=http://localhost:11434/v1
#OFFICE_A_API_KEY=ollama
